# Template only — copy to `.env.local` and fill values. Never commit real secrets.

# Gemini (optional depending on features you use).
GEMINI_API_KEY=

# Public app URL for links / OAuth (local dev shown).
APP_URL=http://localhost:3000

# Helius (`/api/helius/*`, cron).
HELIUS_API_KEY=

# Supabase URL (usually same base for anon + server).
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=

# Anon key: browser / public client + anon server reads.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role: server cron + admin writes only — keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# Optional overrides (defaults match migrations).
SUPABASE_PROJECTS_TABLE=projects
SUPABASE_METRICS_TABLE=project_metrics_snapshots

# Bearer secret for `/api/cron/helius-refresh`.
CRON_SECRET=
